# 构建阶段：安装Android SDK和JDK
FROM ubuntu:22.04 AS android-builder

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/opt/java \
    PATH=$PATH:/opt/java/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools

# 安装基础工具 + JDK 17 + Android SDK
COPY ../resource/commandlinetools-linux-13114758_latest.zip /tmp/
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y wget unzip git curl && \
    rm -rf /var/lib/apt/lists/* && \
    \
    # 安装 JDK
    wget -q https://download.java.net/java/GA/jdk17.0.2/dfd4a8d0985749f896bed50d7138ee7f/8/GPL/openjdk-17.0.2_linux-x64_bin.tar.gz && \
    mkdir -p /opt/java && \
    tar -xzf openjdk-17.0.2_linux-x64_bin.tar.gz -C /opt/java --strip-components=1 && \
    rm openjdk-17.0.2_linux-x64_bin.tar.gz && \
    \
    # 安装 Android commandline tools
    mkdir -p /opt/android-sdk/cmdline-tools && \
    unzip -q /tmp/commandlinetools-linux-13114758_latest.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm /tmp/commandlinetools-linux-13114758_latest.zip && \
    \
    # 安装 SDK 组件
    yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "ndk;25.1.8937393"

# 最终阶段：运行镜像
FROM ubuntu:22.04

# 创建用户和组
RUN addgroup --system --gid 1000 appuser && \
    adduser --system --uid 1000 --gid 1000 appuser && \
    mkdir -p /home/appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app /home/appuser

# 设置工作目录
WORKDIR /app

# 设置时区
ENV TZ=Asia/Shanghai
# 禁止交互式配置
ENV DEBIAN_FRONTEND=noninteractive 

# 配置阿里云镜像源、安装依赖
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y \
    passwd login adduser wget git git-lfs curl \
    tzdata && \
    # 设置时区
    ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone && \
    \
    # 安装uv，并添加到环境变量
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    cp $HOME/.local/bin/uv /usr/local/bin/uv && \
    # 安装 Node.js 和 javascript-obfuscator
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g javascript-obfuscator && \
    javascript-obfuscator -v && \
    # 清理缓存
    rm -rf /var/lib/apt/lists/* 

# 虚拟环境添加到环境变量
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 复制 Android SDK 和 JDK
COPY --from=android-builder --chown=appuser:appuser /opt/android-sdk /opt/android-sdk
COPY --from=android-builder --chown=appuser:appuser /opt/java /opt/java

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/opt/java \
    PATH="$PATH:/opt/java/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools" \
    HOME=/home/appuser \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser

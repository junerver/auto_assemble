# 应用分发资源包目录
DISTRIBUTION_PATH=/app/distribution

# Android基座的项目目录
ANDROID_UNI_BASE_PATH=/app/uni-base

# 是否启用调试模式
FLASK_DEBUG=false

# 是否启用热更新
PORT=5005

# webhook服务地址
WEBHOOK_URL=http://localhost:5005

# 数据库配置
DB_FILE=/app/webhook/webhook_server.db

# Android环境配置
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk
JAVA_HOME=/opt/java
PATH=$PATH:/opt/java/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools 